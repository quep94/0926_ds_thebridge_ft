    "class Perro:\n",
    "\n",
    "    patas = 4\n",
    "    orejas = 2\n",
    "    ojos = 2\n",
    "\n",
    "    def __init__(self, raza, pelo=\"Marrón\", dueno=None):\n",
    "        self.raza = raza\n",
    "        self.pelo = pelo\n",
    "        self.dueno = dueno\n",
    "\n",
    "\n",
    "    def ladrar(self, texto):\n",
    "    \n",
    "        return \"GUAU!\" + texto\n",
    "\n",
    "\n",
    "\n",
    "perro = Perro(\"Labrador\")\n",
    "\n",
    "print(\"=== Atributos ===\")\n",
